# Auth.js: generate with `npx auth secret`
AUTH_SECRET=
# Full deployed URL, e.g. https://mission.talkingsites.org (needed in production)
AUTH_URL=

# Authentik OIDC client (Applications > Providers in Authentik admin)
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# e.g. https://auth.electronworkshop.com.au/application/o/spaceclub-mission-control/
AUTHENTIK_ISSUER=

# Coolify API: base URL without /api, plus a read-only token
COOLIFY_API_URL=
COOLIFY_API_TOKEN=

# Matomo instances named in sites.config.json, MATOMO_<INSTANCE>_URL / _TOKEN
MATOMO_TALKINGSITES_URL=
MATOMO_TALKINGSITES_TOKEN=

# Authentik admin API, for people editing their own profile.
# Base domain only. Token: the spaceclub-mission-control service account (role: view + change users only)
AUTHENTIK_API_URL=
AUTHENTIK_API_TOKEN=

# Postgres. Local dev: the spaceclub-pg podman container on port 5433
DATABASE_URL=
